# Необов'язково: безкоштовний ключ з https://www.omdbapi.com/apikey.aspx — вмикає реальний рейтинг IMDb.
# Скопіюйте цей файл як .env, впишіть ключ і перезапустіть npm run dev.
VITE_OMDB_KEY=

# Рекомендовано: безкоштовний ключ TMDB (v3 API key) — найкраще джерело постерів, року, опису й рейтингу українських серіалів.
# Отримати: https://www.themoviedb.org/settings/api (потрібна безкоштовна реєстрація)
VITE_TMDB_KEY=
